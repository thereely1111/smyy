# ============================================================================
# smyy 环境变量模板（对应 agent-platform-java v0.1.0）
#
# 用法：cp backend.env.example .env，放在**仓库根**（<仓库根>/.env），按自己的环境填。
# 启动时后端会**自动读取它**（application.yml 里的 spring.config.import，本地改动 #7），
# 不需要手工 export / 加载；要临时覆盖某一项，设同名环境变量即可（环境变量优先级更高）。
#
# ⚠ 路径用**正斜杠**；.env 按 Java properties 解析，反斜杠会被当转义符吃掉（\t \n \s 全变形）。
# ⚠ 值里**不能直接写中文**：.env 按 ISO-8859-1 解码，中文会变乱码；
#   必须写 properties 的 \uXXXX 转义（例如 数模演易 = \u6570\u6a21\u6f14\u6613）。
# 带 ⚠ 的项**没有可用默认值**（本包已把上游的开发默认值清空），不填会导致登录或模型调用失败。
# 完整变量清单见 agent-platform/backend/src/main/resources/application.yml。
# ============================================================================

# ---- 工作区：**无需填写** —— 后端启动期自动探测（WorkspaceRootAutoDetector）----------
# 从启动目录向上找到「含 workspace/agents 的目录」即仓库根，自动定为 <仓库根>/workspace；
# 换机器、换盘符/用户名、以及从仓库根 / agent-platform / backend 三种目录启动都不必改。
# 如确实要固定到某个目录，再取消下面这行注释并按绝对路径填写（含中文须 \uXXXX）。
#AGENT_PLATFORM_WORKSPACE_ROOT=E:/\u6570\u6a21\u6f14\u6613/smyy/workspace

# ---- PostgreSQL（需要 pgvector 扩展）--------------------------------------
# 本环境实况：常驻在 192.168.1.245 上（PostgreSQL 16.15，库/用户/密码均为 agent_platform，
# Flyway 版本 v53 与 v0.1.0 一致）→ 本机不再需要 docker compose 起数据库。
# 这三项已写死为 application.yml 的默认值，留空即用 245。
DB_HOST=192.168.1.245
DB_PORT=5432
DB_NAME=agent_platform
DB_USER=agent_platform
DB_PASSWORD=agent_platform

# ---- Redis（登录权限码缓存；缺了能跑，登出会报错）---------------------------
# 本环境实况：常驻在 192.168.1.245 上，**未设密码** → REDIS_PASSWORD 必须留空。
# ⚠ 别和 192.168.1.96:6379 混：那是另一套 Redis，**有密码**。填错的表现是
#   "AUTH called without any password configured"（对 245）或 NOAUTH（对 96）。
REDIS_HOST=192.168.1.245
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- ⚠⚠ 启动必配之一：JWT 签名密钥（不配直接起不来）------------------------
# 校验：长度必须 ≥ 32 字节（AuthProperties.validateJwtSecret，fail-fast）
# 生成：openssl rand -base64 48   或   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(48)).decode())"
AGENT_PLATFORM_JWT_SECRET=
AGENT_PLATFORM_ACCESS_EXPIRE_MINUTES=30
AGENT_PLATFORM_REFRESH_EXPIRE_DAYS=7

# ---- ⚠⚠ 启动必配之二：外部凭据加密密钥（不配直接起不来）---------------------
# 校验：必须是 base64，且解码后**正好 32 字节**（ExternalApiKeyCipher，fail-fast）
# 用途：加密存储知识库等外部 API Key —— 一旦设定就要固定保存，换掉后已存的凭据解不开
# 生成：python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
AGENT_PLATFORM_EXTERNAL_KEY=

# ---- 模型 -----------------------------------------------------------------
# ⚠ v0.1.0 起模型凭证**不再写在 yml/环境变量里**：改由管理端「模型凭证」页配置
#   （ModelCredential，base-url + api-key，用 AGENT_PLATFORM_EXTERNAL_KEY 加密存库），
#   对话时前端可选用哪条凭证（forwardedProps.credential_id + model）。
# 下面两项只是**默认模型名**，以及默认 provider 的兜底 key。
AGENT_PLATFORM_MODEL=openai:glm-5.3-flash
# ⚠ 这个 key 有两个用途，缺了会有硬后果：
#   1) 装配"默认模型"（openai:glm-5.3-flash）时必需 —— 为空则相关接口 500；
#      只用自建凭证时，给个占位值也能让装配通过（真实调用会 401）；
#   2) read_image 多模态读图工具的**唯一**来源 —— 它只认百炼原生协议，
#      OpenAI 兼容中转（kuaipao 等）顶不上。不填则本地补丁会跳过该工具，
#      智能体读不了页码图，公式只能依赖 PDF 文本层。
DASHSCOPE_API_KEY=
# 读图模型：智能体用它读题目页码图里的公式
DASHSCOPE_VL_MODEL=qwen3-vl-plus

# ---- 【推荐】read_image 走 OpenAI 兼容端点（无需百炼账号，见 README 本地改动 #3/#4）----
# 三项齐备时优先于 DashScope。base-url 形如 https://<中转>/v1（末尾斜杠可有可无）
AGENT_PLATFORM_IMAGE_BASE_URL=
AGENT_PLATFORM_IMAGE_API_KEY=
AGENT_PLATFORM_IMAGE_MODEL=qwen3-vl-flash
# 单轮迭代上限（子智能体的 steps 与它对齐）／单次调用超时与重试
AGENT_PLATFORM_MAX_ITERS=50
AGENT_PLATFORM_MODEL_TIMEOUT_MINUTES=4
AGENT_PLATFORM_MODEL_MAX_ATTEMPTS=3

# ---- ⚠ 登录：委托外部认证服务（本包已清空 client 默认值）--------------------
# 校验：只要 auth-server-url 与 client-id 都非空（= OAuth 已启用），
#       userinfo-url 就必须给（AuthProperties.validateOauthConfig，fail-fast，防所有
#       OAuth 用户被识别成同一账号）。若本环境不用 OAuth，把 auth-server-url 留空即可。
# 本环境实况：统一认证中心在 192.168.1.96:9623，scope 填「智能体基座」。
# 地址类四项已写死为 application.yml 默认值；**client-id / client-secret 必须自己填**
# （不填 = OAuth 未启用 = 登录直接 503）。
AGENT_PLATFORM_OAUTH_SERVER_URL=http://192.168.1.96:9623/
AGENT_PLATFORM_OAUTH_CLIENT_ID=
AGENT_PLATFORM_OAUTH_CLIENT_SECRET=
AGENT_PLATFORM_OAUTH_USERINFO_URL=http://192.168.1.96:9623/api/user/info
AGENT_PLATFORM_OAUTH_REDIRECT_URI=http://localhost:5174/auth/callback
AGENT_PLATFORM_OAUTH_TIPDM_PUBLIC_KEY=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDb21hj4a0wDKmlPK0K/zcE5xq+OKETURb10NXetETh+puvboA+jWUUoBWRdLiKZBm4QMtU1JIFSvRQbbsIjGHJNGFCggeH60kLrJ7xjQnNgfufkp0oPL/eUzs8thO8gWNT3HROViIyLeP27gonlhkqZV76yJKM3J95ggZewZbu2wIDAQAB
AGENT_PLATFORM_OAUTH_PERMISSIONS_PATH=/api/user/permissions
AGENT_PLATFORM_OAUTH_PERMISSION_SCOPE=智能体基座

# ---- 【v0.1.0 新增】HITL 闸门超时 -----------------------------------------
AGENT_PLATFORM_HITL_TIMEOUT_ENABLED=false
AGENT_PLATFORM_HITL_TIMEOUT_MINUTES=60
AGENT_PLATFORM_HITL_ALERT_MIN_MINUTES=30

# ---- 【v0.1.0 新增】告警（可选，支持企业微信机器人）-------------------------
AGENT_PLATFORM_ALERT_ENABLED=false
AGENT_PLATFORM_ALERT_WECOM_ENABLED=false
AGENT_PLATFORM_ALERT_WECOM_URL=
AGENT_PLATFORM_ALERT_WECOM_MIN_LEVEL=WARN
AGENT_PLATFORM_ALERT_DEDUP_MINUTES=30
AGENT_PLATFORM_ALERT_RETENTION_DAYS=30

# ---- 【v0.1.0 新增】技能仓库导入（管理端"从技能仓库导入"的数据源）------------
AGENT_PLATFORM_SKILL_REPO_ENABLED=false
AGENT_PLATFORM_SKILL_REPO_TYPE=git
AGENT_PLATFORM_SKILL_REPO_URL=
AGENT_PLATFORM_SKILL_REPO_BRANCH=
AGENT_PLATFORM_SKILL_REPO_TOKEN=

# ---- 可选：联网检索（web_search 工具）-------------------------------------
BOCHA_API_KEY=

# ---- 可选：运行态回收（按目录 mtime 清理超期会话产物）----------------------
AGENT_PLATFORM_RUNTIME_GC_ENABLED=false
AGENT_PLATFORM_RUNTIME_GC_MAX_AGE_DAYS=30
AGENT_PLATFORM_SUBAGENT_RETENTION_DAYS=7

# ---- 可选：AG-UI 事件落库（排查用，量大时注意库增长）------------------------
AGENT_PLATFORM_AGUI_EVENT_LOG=false

# ---- 可选：外发与沙箱控制 -------------------------------------------------
# 是否允许请求内网地址（web_fetch 等）——默认关闭，安全考虑
AGENT_PLATFORM_ALLOW_PRIVATE_OUTBOUND=false

# ---- 服务端口 -------------------------------------------------------------
SERVER_PORT=8080
