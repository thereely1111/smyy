# 复制为 .env.local 后按需修改（.env.local 不入库）

# ── 后端地址（Vite 代理目标） ──────────────────────────────
# 后端源码在本仓库 agent-platform-java/，默认 :8080，启动见该目录 README。
# ⚠️ 判端点是否存在**不能只看状态码** —— 未知 GET 路径会被 SPA 兜底
#    返回 200 + HTML，必须看响应体是不是 JSON。
VITE_BACKEND_TARGET=http://localhost:8085
VITE_BACKEND_TARGET_AGENT=http://localhost:8084
# 双 token 开关：两端 JWT 密钥与 userId 都不通用，登录要各签一份。
# 不填 = dev 开 / prod 关（生产 nginx 同源部署，一份 token 就够）。0 强制关，1 强制开。
# VITE_DUAL_TOKEN=1

# ── 智能体（File Agent） ───────────────────────────────────
# 目录名 —— 对应后端 workspace/agents/<此名>/
VITE_SMYY_AGENT_NAME=数学建模解答助手
# agentId 已改为**运行时推导**（src/config/index.ts + src/utils/nameUuid.ts），
# 等价 Java UUID.nameUUIDFromBytes(目录名)，因此这里无需写 UUID。
# 仅在需要指向一个「目录名对不上」的临时实例时才取消下面这行的注释并填值：
# VITE_SMYY_AGENT_ID=
# 换算 / 核对：node scripts/sandbox/check-agent-id.mjs 数学建模解答助手

# ── 沙箱 ───────────────────────────────────────────────────
#   real = 走真后端；mock = 本地假会话（后端未登录/未就绪时演示）
VITE_SANDBOX_MODE=real
#   产物树轮询间隔（ms）。0 = 不轮询，仅在 run 结束或手动刷新时拉一次
VITE_SANDBOX_ARTIFACTS_POLL=0
#   附件单文件上限（MB），与后端 MAX_ATTACH_BYTES 一致
VITE_SANDBOX_ATTACH_MAX_MB=20
#   是否把工具结果解析为 { stdout, stderr, exitCode, elapsed }
#   解析失败会自动降级为原始文本，不会空白
VITE_SANDBOX_EXEC_STRUCTURED=true
#   代码执行的绑定通道：
#     local   = 前端同页执行（默认）—— 只支持 JS/TS，零后端依赖，不是安全隔离
#     backend = 会话工作区里进程隔离执行（.../shell/run）—— 后端接口未上线（契约已冻结）
#   选 backend 而后端未实现时会如实报错，不会静默回落 local
VITE_SANDBOX_EXEC_CHANNEL=local
#   会话产物保留天数，仅用于前端文案提示（0 = 不提示）
#   真正的清理由部署侧决定，这里填的数必须与部署侧实际策略一致
VITE_SANDBOX_RETENTION_DAYS=0

# ── 分析通道（智能体做不做真分析） ─────────────────────────
#   与 VITE_SANDBOX_MODE **分开**：那个管沙箱假会话，这个管「要不要真调智能体做分析」。
#   real = 真跑（默认；后端不可用时链路自己回落）；mock = 不调后端、直接走假分析
#   读取处：src/stores/analysis.ts
VITE_ANALYSIS_MODE=real

# ── 登录对接模式 ───────────────────────────────────────────
#   真实登录走 /api/auth/*（需后端 + 数据库就绪）
VITE_AUTH_MODE=real

# ── Agent 图像生成（后端调用 OpenAI 兼容 /v1/images/generations） ──
AGENT_PLATFORM_IMAGE_GENERATION_BASE_URL=https://your-image-provider.example.com
AGENT_PLATFORM_IMAGE_GENERATION_MODEL=gpt-image-2
# 生图专用 key。留空则回退用 AGENT_PLATFORM_IMAGE_API_KEY（读图那把）。
# 若中转站上生图与读图不是同一把 key（分组权限不同），必须单独填生图那把，
# 否则会 503 No available channel for model ... under group ...
AGENT_PLATFORM_IMAGE_GENERATION_API_KEY=
