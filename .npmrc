# pnpm：允许这几个包的构建脚本运行
#   esbuild     —— Vite 的依赖，不跑会拿不到可执行二进制，dev 起不来
#   @parcel/watcher —— 文件监听
#   vue-demi    —— 桥接 Vue2/3（Element Plus 依赖链）
#   core-js     —— polyfill，postinstall 被跳过只会留一行无害告警，这里一并放行
# 不写这份白名单时 pnpm 会静默跳过构建，表现为「装了但 Vite 起不来」。
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=@parcel/watcher
onlyBuiltDependencies[]=vue-demi
onlyBuiltDependencies[]=core-js

# 用扁平（hoisted）链接模式代替默认的隔离（isolated）模式。
# 2026-10-19：本机在隔离模式下反复出现「Failed to create symlink ... 系统找不到指定的文件
# (os error 2)」——Windows 上 .pnpm/node_modules/<包> 虚拟软链建不起来（多为慢网下包解压
# 不完整所致）。hoisted 不依赖这层软链，装完即可用，且对 Vite/Vue 这类项目解析无影响。
node-linker=hoisted
